# Copy to backend/.env and fill in.

# Reasoning — pick one LLM vendor: gemini | openai | anthropic.
# Left empty, Relay uses the first vendor below that has a key.
LLM_PROVIDER=

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# OpenAI: https://platform.openai.com/api-keys
# OPENAI_BASE_URL points at any OpenAI-compatible API instead (Azure, Groq, Mistral,
# DeepSeek, xAI, OpenRouter, a local Ollama at http://localhost:11434/v1, ...).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=

# Anthropic: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high; leave empty for older models without effort support
ANTHROPIC_EFFORT=low

# Shared audio — LiveKit Cloud project settings: https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Transcription — https://console.deepgram.com
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# Speech — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_flash_v2_5
